  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
