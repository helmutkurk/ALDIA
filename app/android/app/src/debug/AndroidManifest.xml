<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is required for development (hot reload, debugger). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds may call the local API over http (10.0.2.2 from the emulator).
         Release builds keep cleartext traffic off. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
